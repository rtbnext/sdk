{
  "name": "@rtbnext/sdk",
  "description": "Official SDK for the RTBNext API",
  "license": "MIT",
  "version": "1.0.0",
  "author": {
    "name": "Paul Köhler (komed3)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "homepage": "https://rtbnext.de",
  "keywords": [
    "rtbnext",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtbnext/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/rtbnext/sdk/issues"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/komed3"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "default": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./bundle": "./dist/bundle.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:dts": "tsc -p tsconfig.dts.json",
    "build:all": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.dts.json",
    "format": "prettier --ignore-path \"\" --write \"./dist/**/*.@(js|d.ts)\" --log-level warn",
    "bundle": "esbuild dist/esm/index.js --bundle --minify --legal-comments=none --format=iife --global-name=rtbnext --outfile=dist/bundle.js",
    "build": "npm run clean && npm run build:all && npm run format && npm run bundle",
    "postbuild": "tsc-alias && node scripts/postbuild.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@rtbnext/schema": "^2.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
