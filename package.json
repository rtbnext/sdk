{
  "name": "@rtbnext/sdk",
  "description": "Official SDK for the RTBNext API",
  "version": "1.0.0",
  "license": "MIT",
  "author": {
    "name": "Paul Köhler (komed3)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtbnext/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/rtbnext/sdk/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:dts": "tsc -p tsconfig.dts.json",
    "build:all": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.dts.json",
    "format": "prettier --ignore-path \"\" --write \"./dist/**/*.@(js|d.ts)\" --log-level warn",
    "bundle": "esbuild dist/esm/index.js --bundle --minify --legal-comments=none --format=iife --global-name=rtbnext --outfile=dist/rtbnext.js",
    "build": "npm run clean && npm run build:all && npm run format && npm run bundle",
    "postbuild": "tsc-alias",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@rtbnext/schema": "^2.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
